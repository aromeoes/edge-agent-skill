# Calendar (events, RSVPs, venues). Mint in the EdgeOS portal under /portal/api-keys,
# or via POST /api/v1/api-keys if you have a bearer token. Restricted to event-automation routes.
EDGEOS_API_KEY=            # Personal calendar key, eos_live_...

# Portal — own profile (/humans/me), attendee directory, minting calendar keys.
# OTP-derived JWT. End users get it by logging into the EdgeOS portal.
# Integrating apps can also mint one via the third-party login flow (see EDGEOS_TENANT_API_KEY).
EDGEOS_BEARER_TOKEN=       # EdgeOS portal JWT

# Optional — only needed if this process is an integrating app fronting auth for a user
# (e.g. OpenClaw). Tenant-wide, regenerable in the backoffice. Used to drive the
# /auth/human/third-party/{login,authenticate} OTP exchange.
EDGEOS_TENANT_API_KEY=     # X-Third-Party-Api-Key header value

# Optional — defaults to the Edge Esmeralda 2026 popup if unset.
EDGEOS_POPUP_ID=43746fd0-bce2-472b-93e4-a438177b2dff
